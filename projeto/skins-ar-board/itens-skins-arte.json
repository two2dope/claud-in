[{"id": "S1", "title": "Skin Mangue: as 9 poses", "sev": "dec", "img": "data:image/png;base64,", "alt": "Nove poses do caranguejo coral", "contexto": "Ordem: idle, think, read, code, run, search, ok, err, alert. Reduzido do Flow para 64x48, 1 pixel por bloco, paleta travada. Sai como o desenho padrão.", "proposta": "Aprove se a identidade bate com a A1. Comente a pose que não serve."}, {"id": "S2", "title": "Skin Maré: as 9 poses", "sev": "dec", "img": "data:image/png;base64,", "alt": "Nove poses do caranguejo azul-esverdeado", "contexto": "Ordem: idle, think, read, code, run, search, ok, err, alert. Em run e search o corpo saiu inclinado e diferente da silhueta do Mangue; code ganhou uma borda clara.", "proposta": "Aprove só se a silhueta importar pouco, ou rejeite para eu gerar a Maré por troca de paleta a partir do Mangue (silhueta idêntica, zero geração)."}, {"id": "S3", "title": "Skin Malungo: as 9 poses (chapéu de palha)", "sev": "dec", "img": "data:image/png;base64,", "alt": "Nove poses do caranguejo cinza com chapéu de palha", "contexto": "Ordem: idle, think, read, code, run, search, ok, err, alert. Só o chapéu, sem rosto nem óculos. O chapéu muda de tamanho entre poses e em code as antenas viraram duas formas claras que parecem asas.", "proposta": "Aprove se a homenagem funciona. Comente se quer o chapéu com tamanho fixo em todas as poses."}, {"id": "M1", "title": "Minis da frota: as 5 criaturas (24x24)", "sev": "dec", "img": "data:image/png;base64,", "alt": "Siri azul, garça lilás, guaiamum âmbar, aratu verde e caranguejinho cinza", "contexto": "Siri azul (Explorar), garça lilás (Planejar), guaiamum âmbar (Executar), aratu verde (Revisar), caranguejinho cinza (outros). Os olhos do siri viraram uma barra; o aratu vem com o ramo, então o corpo ficou pequeno.", "proposta": "Aprove o conjunto. A correção de olhos e do ramo do aratu entra na ingestão final."}, {"id": "D1", "title": "Pose de erro (X nos olhos) ficou fraca", "sev": "crit", "img": "data:image/png;base64,", "alt": "Pose de erro do Mangue e da Maré", "contexto": "Com 1 pixel por bloco, o X dos olhos some no Mangue e fica ambíguo na Maré. Erro precisa ser legível.", "proposta": "Aprove para eu regerar só as 3 poses de erro com o X grande (olhos de 2x2 blocos) ou redesenhar por script; rejeite se o sinal de cor e o texto já bastam."}, {"id": "D2", "title": "Silhueta: só 2 pernas, e a mesma em todas as skins", "sev": "rec", "contexto": "A âncora tem 2 pernas e o prompt mandou manter. O mascote atual tinha 4. Skins com pernas diferentes do atual podem estranhar na caixa.", "proposta": "Recomendo manter as 2 pernas (identidade da âncora). Comente se quer 4."}, {"id": "D3", "title": "Ingestão final: aprovar o pipeline antes de copiar para o pacote", "sev": "rec", "contexto": "Cada PNG tem menos de 1 KB (limite 90 KB), alfa de 1 bit, paleta de 9 a 10 cores por skin, grade de 64x48. Fica em assets/skins/ fora do pacote até o código das skins existir.", "proposta": "Aprove para eu manter esses PNGs como fonte da arte e fazer as correções de D1 e M1 depois do veredito."}]